{
  "name": "livediff",
  "private": true,
  "type": "module",
  "version": "0.6.0",
  "description": "Local, live-updating git worktree diff hub with agent-readable review comments",
  "license": "MIT",
  "bin": {
    "livediff": "server/cli.js"
  },
  "files": [
    "server",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "serve": "node server/index.js",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "e2e": "playwright test",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepack": "vite build"
  },
  "dependencies": {
    "@git-diff-view/core": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "highlight.js": "^11.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "4.1.10",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "7.0.2",
    "vite": "^6.4.3",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
