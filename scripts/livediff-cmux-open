#!/usr/bin/env bash
set -euo pipefail

# Thin delegate: the real workspace-selection logic lives in server/cmux-open.ts (compiled to
# dist-server/server/cmux-open.js) so there is exactly one implementation, shared with
# `livediff setup --browser cmux`. See that file for the algorithm and its rationale.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec node "$SCRIPT_DIR/../dist-server/server/cmux-open.js" "$@"
